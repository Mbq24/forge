FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build-env
WORKDIR /app

# Copy csproj and restore as distinct layers
COPY RegressionModelCloseLong.WebApp/*.csproj ./RegressionModelCloseLong.WebApp/
COPY RegressionModelCloseLong.Model/*.csproj ./RegressionModelCloseLong.Model/
RUN dotnet restore .csharp-model/RegressionModelCloseLong/RegressionModelCloseLong.WebApp.csproj

# Copy everything else and build
COPY . ./
RUN dotnet publish -c Release -o out ./RegressionModelCloseLong/RegressionModelCloseLong.WebApp.csproj

# Build runtime image
FROM mcr.microsoft.com/dotnet/aspnet:6.0
WORKDIR /app
COPY --from=build-env /app/out .
COPY --from=build-env /app/RegressionModelCloseLong.Model/MLModel.zip .

# Expose port 80
EXPOSE 80

ENTRYPOINT ["dotnet", "RegressionModelCloseLong.WebApp.dll"]